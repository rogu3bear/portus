# Portus Environment Configuration (Example)
# Copy this file to .env and update the values

# API Settings
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=4
API_RELOAD=True
API_LOG_LEVEL=info

# Database Settings
# Path to the SQLite database used by the backend.
DB_PATH=./data/lan-orchestrator.db
DATABASE_ECHO=false

# Zoraxy Settings
ZORAXY_PORT=9500
ZORAXY_ADMIN_PORT=4001
ZORAXY_ADMIN_USER=admin
ZORAXY_ADMIN_PASSWORD=change-me-please

# DNS Settings
DNS_PORT=8053
DNS_DOMAIN=lan
DNS_TTL=3600

# UI Settings
UI_PORT=5173
UI_API_URL=http://localhost:${API_PORT}

# Traefik Settings
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_DASHBOARD_AUTH_USER=admin
TRAEFIK_DASHBOARD_AUTH_PASSWORD=change-me-please

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=change-me-to-a-secure-secret
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:${UI_PORT}", "http://127.0.0.1:${UI_PORT}"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["Content-Type", "Authorization"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Authentication
AUTH_ENABLED=true
AUTH_SESSION_EXPIRY_MINUTES=10080  # 7 days

